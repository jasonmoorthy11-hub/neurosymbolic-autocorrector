# Neurosymbolic Autocorrector configuration
#
# Every line is commented out: an unedited copy of this file changes nothing, and
# the system runs offline (in-memory policy store, no LLM tier).
# Uncomment only what you need. All settings: src/autocorrector/config.py

# LLM correction tier and translation (paid API)
# AUTOCORRECTOR_ANTHROPIC_API_KEY=
# Vector embeddings only (scripts/seed_neo4j.py --embed); not used by the correction path
# AUTOCORRECTOR_OPENAI_API_KEY=

# Neo4j. Leave the URI unset for the in-memory store; once it is set, every service
# connects at startup. bolt://localhost:7687 for a local server, neo4j+s://<id>.databases.neo4j.io for Aura
# AUTOCORRECTOR_NEO4J_URI=bolt://localhost:7687
# AUTOCORRECTOR_NEO4J_USER=neo4j
# AUTOCORRECTOR_NEO4J_PASSWORD=
# AUTOCORRECTOR_NEO4J_DATABASE=neo4j

# MCP HTTP server (the `autocorrector` command); the dashboard API port is set by uvicorn
# AUTOCORRECTOR_HOST=127.0.0.1
# AUTOCORRECTOR_PORT=8000
# AUTOCORRECTOR_MCP_API_KEY=

# Dashboard API: when set, mutating and export routes require the X-API-Key header.
# The bundled React UI does not send it (see dashboard/README.md)
# AUTOCORRECTOR_DASHBOARD_API_KEY=
# AUTOCORRECTOR_CORS_ORIGINS=["http://localhost:3000"]
# Reverse proxies (addresses or CIDRs) whose X-Forwarded-For names the client for
# rate limiting; unset = the header is never read
# AUTOCORRECTOR_TRUSTED_PROXIES=["172.31.250.10"]

# Correction pipeline
# AUTOCORRECTOR_MAX_CORRECTION_ATTEMPTS=3
# AUTOCORRECTOR_CORRECTION_CONFIDENCE_SCORE=0.92

# Audit log (SQLite file)
# AUTOCORRECTOR_AUDIT_DB_PATH=autocorrector_audit.db

# Logging
# AUTOCORRECTOR_LOG_LEVEL=INFO
