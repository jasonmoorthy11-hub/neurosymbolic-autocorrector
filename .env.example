# Neurosymbolic Autocorrector Configuration

# LLM API Keys
AUTOCORRECTOR_ANTHROPIC_API_KEY=sk-ant-...
AUTOCORRECTOR_OPENAI_API_KEY=sk-...

# Neo4j (Neo4j Aura Free — get credentials from https://neo4j.com/cloud/aura-free)
# For Aura, use neo4j+s:// protocol (TLS encrypted)
AUTOCORRECTOR_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
AUTOCORRECTOR_NEO4J_USER=neo4j
AUTOCORRECTOR_NEO4J_PASSWORD=your-aura-password-here
AUTOCORRECTOR_NEO4J_DATABASE=neo4j

# Redis
AUTOCORRECTOR_REDIS_URL=redis://localhost:6379

# Server
AUTOCORRECTOR_HOST=0.0.0.0
AUTOCORRECTOR_PORT=8000
AUTOCORRECTOR_DEBUG=false

# Correction Pipeline
AUTOCORRECTOR_MAX_CORRECTION_ATTEMPTS=3
AUTOCORRECTOR_CORRECTION_CONFIDENCE_THRESHOLD=0.85

# Embeddings (for vector-based policy search)
AUTOCORRECTOR_EMBEDDING_MODEL=text-embedding-3-small
AUTOCORRECTOR_EMBEDDING_DIMENSIONS=1536

# Logging
AUTOCORRECTOR_LOG_LEVEL=INFO
